# .htaccess - LifeFlow360
# Wird beim Astro-Build automatisch nach dist/lifeplus-website/.htaccess kopiert.
# Apache liest die Datei hierarchisch, daher gelten die Regeln auch fuer
# Unterordner wie /app/.

# ---------------------------------------------------------------------------
# Domain-Kanonisierung: Apex (lifeflow360.app) auf www umleiten
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_HOST} ^lifeflow360\.app$ [NC]
    RewriteRule ^(.*)$ https://www.lifeflow360.app/$1 [L,R=301]
</IfModule>

# ---------------------------------------------------------------------------
# HTTPS erzwingen
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ---------------------------------------------------------------------------
# Cache-Steuerung + TDM-Nutzungsvorbehalt (Paragraph 44b UrhG)
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header set X-Robots-Tag "noai, noimageai, noindex, nofollow, noarchive, nosnippet"
    Header set Tdm-Reservation "1"

    # App shell und PWA-Steuerdateien immer frisch vom Server holen.
    <FilesMatch "(\.html)$|^(sw\.js|registerSW\.js|manifest\.webmanifest)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # Vite-Assets mit Content-Hash koennen dauerhaft gecacht werden.
    <FilesMatch "[-.][A-Za-z0-9_-]{8,}\.(js|css|woff2?|png|svg|jpe?g|webp)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------------
# Bekannte KI- und Scraper-Bots blockieren (normale Suchmaschinen bleiben zu)
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{HTTP_USER_AGENT} ClaudeBot              [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} Claude-Web             [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} anthropic-ai           [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} Claude-SearchBot       [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} Claude-User            [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} GPTBot                 [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} ChatGPT-User           [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} OAI-SearchBot          [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} Google-Extended        [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} GoogleOther            [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} CCBot                  [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} PerplexityBot          [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} Perplexity-User        [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} Bytespider             [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} Amazonbot              [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} Meta-ExternalAgent     [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} Meta-ExternalFetcher   [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} FacebookBot            [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} facebookexternalhit    [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} Applebot-Extended      [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} cohere-ai              [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} cohere-training-data-crawler [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} MistralAI-User         [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} YouBot                 [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} Diffbot                [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} DuckAssistBot          [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} omgili                 [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} omgilibot              [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} ImagesiftBot           [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} Timpibot               [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} PanguBot               [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} AI2Bot                 [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} Ai2Bot-Dolma           [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} Webzio-Extended        [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} VelenPublicWebCrawler  [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} Sidetrade              [NC]

    RewriteRule ^.*$ - [F,L]
</IfModule>

# ---------------------------------------------------------------------------
# Robots-/AI-/LLMs-Dateien explizit zugaenglich halten
# ---------------------------------------------------------------------------
<FilesMatch "^(robots\.txt|ai\.txt|llms\.txt)$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule mod_headers.c>
        Header set X-Robots-Tag "noindex"
    </IfModule>
</FilesMatch>

# ---------------------------------------------------------------------------
# Verzeichnislistings und versteckte Dateien
# ---------------------------------------------------------------------------
Options -Indexes

<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>
