---
// Free-Signup / Consent (Codex-Modell).
// Vorlage: _doc/paddle_checkout/lifeplus_signup_free_Claude.html
import BrandLayout from '@shared/components/layout/BrandLayout.astro';
import Header from '@shared/components/layout/Header.astro';
import Footer from '@shared/components/layout/Footer.astro';
import SignupPage from '@shared/components/sections/SignupPage.astro';
import { getBrand } from '@shared/lib/brand';

const brand = await getBrand('lifeplus');
---
<BrandLayout
  brand={brand}
  title={`Kostenlos starten · ${brand.siteName}`}
  description={`${brand.siteName} 14 Tage Pro kostenlos testen — kein Zahlungsmittel noetig.`}
>
  <Header brand={brand} active="pricing" />
  <SignupPage brand={brand} source="brands/lifeplus/pages/signup.astro" />
  <Footer brand={brand} />
</BrandLayout>
