---
// Pro-Plan-Checkout (Codex-Modell). Dynamic-Route.
// URL: /checkout/yearly | /checkout/halfyear | /checkout/monthly
// Historische Checkout-Prototypen wurden durch das B2B-v6.1-Runbook ersetzt.
// Fuehrender Stand: _doc/paddle_checkout/checkout-billing-runbook-b2b-v6-1.md
// Plan-Param liegt im URL-Pfad — funktioniert sowohl im SSG-Build (statisch
// vorgebaut per getStaticPaths) als auch im Dev-Server, ohne SSR-Adapter.
import BrandLayout from '@shared/components/layout/BrandLayout.astro';
import Header from '@shared/components/layout/Header.astro';
import Footer from '@shared/components/layout/Footer.astro';
import CheckoutPage from '@shared/components/sections/CheckoutPage.astro';
import { getBrand } from '@shared/lib/brand';

export function getStaticPaths() {
  return [
    { params: { plan: 'monthly' } },
    { params: { plan: 'halfyear' } },
    { params: { plan: 'yearly' } },
  ];
}

type PlanKey = 'monthly' | 'halfyear' | 'yearly';
const plan = Astro.params.plan as PlanKey;

const brand = await getBrand('lifeplus');

// Tier-Label fuer die linke Bestelluebersicht. Die echten Preise/Perioden
// liegen in CheckoutPage.astro (planPricing); hier nur das Anzeige-Label,
// das auf der Pricing-Page synchron gehalten werden muss.
const tierName: Record<PlanKey, string> = {
  monthly:  '1 Monat',
  halfyear: '6 Monate',
  yearly:   '12 Monate',
};

const priceIdMap: Record<PlanKey, string | undefined> = {
  monthly:  brand.paddle.priceIdMonthly,
  halfyear: brand.paddle.priceIdHalfYear,
  yearly:   brand.paddle.priceIdYearly,
};
const priceId = priceIdMap[plan];
if (!priceId) return Astro.redirect('/pricing.html');
---
<BrandLayout
  brand={brand}
  title={`Bezahlung · ${brand.siteName} ${tierName[plan]}`}
  description={`${brand.siteName} ${tierName[plan]} sicher per Paddle bezahlen.`}
  paddle
>
  <Header brand={brand} active="pricing" />
  <CheckoutPage
    brand={brand}
    tierName={tierName[plan]}
    plan={plan}
    priceId={priceId}
    source={`brands/lifeplus/pages/checkout/[plan].astro?plan=${plan}`}
  />
  <Footer brand={brand} />
</BrandLayout>
