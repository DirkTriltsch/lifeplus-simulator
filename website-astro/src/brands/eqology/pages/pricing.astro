---
import BrandLayout from '@shared/components/layout/BrandLayout.astro';
import Header from '@shared/components/layout/Header.astro';
import Footer from '@shared/components/layout/Footer.astro';
import PricingPageDefault from '@shared/components/sections/PricingPageDefault.astro';
import type { PricingPage } from '@shared/content-schemas/pricing';
import { getBrand } from '@shared/lib/brand';

const brand = await getBrand('eqology');

const pricing = {
  seo: {
    title: 'Preise',
    description:
      'EqoFlow360 · Frei starten oder Pro mit 1, 6 oder 12 Monaten Laufzeit nutzen. Alle Pro-Pläne mit vollem Funktionsumfang. Bei gewerblicher Nutzung in der Regel als Betriebsausgabe behandelbar — bitte mit dem Steuerberater abstimmen.',
  },

  hero: {
    eyebrow: 'Preise & Konditionen',
    h1Html: 'Ein Werkzeug.<br><em>Vier klare Optionen.</em>',
    subHtml:
      'Frei starten, flexibel monatlich nutzen oder mit 6 bzw. 12 Monaten vorausplanen — du wählst die passende Form. Bei gewerblicher Nutzung in der Regel als <strong>Betriebsausgabe</strong> behandelbar (Details mit deinem Steuerberater).',
  },

  vatBanner: {
    title: 'Alle Preise verstehen sich netto, zzgl. gesetzlicher USt.',
    body:
      'Im Checkout wird die länderspezifische USt. ausgewiesen. Für Unternehmer mit gültiger EU-VAT-ID greift Reverse-Charge.',
  },

  tiers: [
    {
      id: 'free',
      name: 'Frei',
      descHtml: '14 Tage Pro testen,<br>danach Free nutzen.',
      currency: '€',
      value: '0',
      unit: '/Monat',
      billed: 'kostenlos · mit Magic-Link · ohne Kreditkarte',
      features: [
        { strong: 'Jahr 1-4 sichtbar', text: '— langfristige Werte bleiben begrenzt' },
        { text: '1 aktuelles Szenario, keine Speicherung' },
        { text: 'Ideal, um das Prinzip kennenzulernen' },
      ],
      cta: { kind: 'link', label: 'Plan jetzt starten', url: '/app/' },
    },
    {
      id: 'monthly',
      name: '1 Monat',
      descHtml: 'Flexibel,<br>monatlich kündbar.',
      currency: '€',
      value: '14,95',
      unit: '/Monat',
      unitNote: 'netto',
      billed: '€14,95 netto monatlich · zzgl. USt. · monatlich kündbar',
      features: [
        { strong: 'Voller Funktionsumfang', text: '— alle Jahre und Kennzahlen' },
        { text: 'Handy, Tablet & Desktop' },
        { text: 'Monatlich kündbar' },
      ],
      cta: { kind: 'paddle', label: 'Plan jetzt starten', plan: 'monthly', priceIdKey: 'monthly' },
    },
    {
      id: 'halfyear',
      badge: 'Halber Monat gratis',
      name: '6 Monate',
      descHtml: 'Halbjährlich planen,<br>ein halber Monat gratis.',
      currency: '€',
      value: '13,71',
      unit: '/Monat',
      unitNote: 'netto',
      billed: '€82,23 netto alle 6 Monate · zzgl. USt. · halber Monat gratis',
      features: [
        { strong: 'Alles aus 1 Monat', text: '' },
        { text: 'Eine Rechnung pro Halbjahr' },
        { text: 'Verlängert sich um 6 Monate · Rabatt bleibt erhalten' },
        { text: 'Ab Verlängerung monatlich kündbar, Restmonate zurück' },
      ],
      cta: { kind: 'paddle', label: 'Plan jetzt starten', plan: 'halfyear', priceIdKey: 'halfyear' },
    },
    {
      id: 'yearly',
      featured: true,
      badge: 'Empfehlung · 2 Monate gratis',
      name: '12 Monate',
      descHtml: 'Jährlich sparen,<br>zwei Monate gratis.',
      currency: '€',
      value: '12,46',
      unit: '/Monat',
      unitNote: 'netto',
      billed: '€149,50 netto jährlich · zzgl. USt. · 2 Monate gratis',
      features: [
        { strong: 'Alles aus 1 Monat', text: '' },
        { text: 'Eine Rechnung pro Jahr' },
        { text: 'Verlängert sich um 12 Monate · Rabatt bleibt erhalten' },
        { text: 'Ab Verlängerung monatlich kündbar, Restmonate zurück' },
      ],
      cta: { kind: 'paddle', label: 'Plan jetzt starten', plan: 'yearly', priceIdKey: 'yearly' },
    },
  ],

  notes: [
    {
      icon: 'info',
      title: 'Treue belohnt: Dein Rabatt bleibt — und ab der Verlängerung wirst du flexibel.',
      body:
        'Im 1-Monats-Plan kündigst du jederzeit zum Ende des laufenden Monats. Im 6- und 12-Monats-Plan zahlst du den Rabattpreis für die gewählte Laufzeit; dein Plan verlängert sich automatisch um die gleiche Laufzeit zum jeweils gültigen Rabattpreis dieses Tarifs. Bei Preisanpassungen informieren wir dich rechtzeitig vor Wirksamwerden; im Fall einer Erhöhung steht dir ein Sonderkündigungsrecht zu. Ab der ersten Verlängerung kannst du monatlich zum Monatsende kündigen — nicht genutzte volle Restmonate erstatten wir anteilig zurück.',
    },
    {
      icon: 'doc',
      title: 'Saubere Rechnung für deine Unterlagen.',
      body:
        'Du erhältst eine ordnungsgemäße Rechnung mit den relevanten Angaben. Wenn du EqoFlow360 für deine Sponsoring-Tätigkeit nutzt, kannst du die Kosten in der Regel als Betriebsausgabe geltend machen. Bitte kläre die konkrete steuerliche Behandlung im Zweifel mit deinem Steuerberater.',
    },
  ],

  compare: {
    headlineHtml: 'Was ist <em>jeweils</em> enthalten?',
    sub: 'Free zeigt den Einstieg. Pro ist in allen Laufzeiten funktional identisch — der Unterschied ist die Abrechnung.',
    columns: [
      { name: 'Free', sub: '€0' },
      { name: '1 Monat', sub: '€14,95' },
      { name: '6 Monate', sub: '€13,71/Mon' },
      { name: '12 Monate', sub: '€12,46/Mon', featured: true },
    ],
    rows: [
      { feature: '5-Slider-Simulator', cells: ['begrenzt', 'check', 'check', 'check'] },
      { feature: '10-Jahres-Verlauf & Chart', cells: ['Jahr 1-4', 'check', 'check', 'check'] },
      { feature: 'Stufen-Prognose (Believer → 3* Diamond)', cells: ['begrenzt', 'check', 'check', 'check'] },
      { feature: 'Reality-Strategien (Personenbaum / Zufallsstreuung / Momentum)', cells: ['begrenzt', 'check', 'check', 'check'] },
      { feature: 'Ziele-Leiter mit eigenen Zwischenzielen', cells: ['Demo-Ziele', 'check', 'check', 'check'] },
      { feature: 'Netzwerk-Visualisierungen (Tabelle, Sunburst, Bein-Spalten, Hybrid-Tree)', cells: ['Basis', 'check', 'check', 'check'] },
      { feature: 'Szenario per URL teilen (Handy, Tablet, Desktop)', cells: ['Magic-Link', 'check', 'check', 'check'] },
      { feature: 'Abrechnung', cells: ['kostenlos', 'monatlich', 'halbjährlich', 'jährlich'] },
      { feature: 'Bindung / Kündigung', cells: ['-', 'monatlich kündbar', '6 Mon. fest, dann monatlich', '12 Mon. fest, dann monatlich'] },
      { feature: 'Verlängerung', cells: ['-', 'monatlich', 'um 6 Monate', 'um 12 Monate'] },
      { feature: 'Rabatt in der Verlängerung', cells: ['-', '—', 'bleibt erhalten', 'bleibt erhalten'] },
      { feature: 'Anteilige Erstattung bei Kündigung', cells: ['-', '—', 'ab 1. Verlängerung', 'ab 1. Verlängerung'] },
    ],
  },

  faq: {
    headlineHtml: 'Fragen zur <em>Abrechnung.</em>',
    items: [
      {
        q: 'Wie kann ich kündigen?',
        a: [
          'Im <strong>1-Monats-Plan</strong> kündigst du jederzeit zum Ende des laufenden Monats — ein Klick im Account-Bereich genügt, keine Begründung nötig.',
          'Im <strong>6- oder 12-Monats-Plan</strong> bindest du dich für die gewählte Erstlaufzeit. Ab der ersten Verlängerung kannst du dann monatlich kündigen — nicht genutzte volle Restmonate erstatten wir dir anteilig zurück.',
          'Die Kündigung erfolgt im Account-Bereich oder über das Paddle-Kundenportal.',
        ],
      },
      {
        q: 'Wie verlängert sich mein Plan — und bleibt mein Rabatt erhalten?',
        a: [
          'Dein Plan verlängert sich automatisch um die <strong>gleiche Laufzeit</strong>: ein 6-Monats-Plan um weitere 6 Monate, ein 12-Monats-Plan um weitere 12 Monate.',
          'Der Rabattpreis für deine gewählte Laufzeit bleibt dabei erhalten und gilt auch in der Verlängerung. Treue wird also belohnt.',
          'Ab der ersten Verlängerung kannst du deinen Plan jederzeit monatlich zum Monatsende kündigen. Nicht genutzte volle Restmonate erstatten wir anteilig zurück.',
        ],
      },
      {
        q: 'Kann ich vom Monats- aufs Jahresabo wechseln (oder umgekehrt)?',
        a: ['Ja. Du kannst zwischen 1, 6 und 12 Monaten wechseln. Nicht verbrauchte Restzeit wird dabei angerechnet oder anteilig erstattet.'],
      },
      {
        q: 'Ist EqoFlow360 als Betriebsausgabe absetzbar?',
        a: [
          'Für Sponsoren, die mit dem Abo ihre Sponsoring-Tätigkeit unterstützen, ist es in aller Regel als Betriebsausgabe absetzbar. Die Rechnung enthält alle steuerlich relevanten Angaben.',
          'Wir sind keine Steuerberater — sprich im Zweifelsfall mit deinem.',
        ],
      },
      {
        q: 'Welche Zahlungsmethoden gibt es?',
        a: ['Kreditkarte (Visa, Mastercard, Amex), SEPA-Lastschrift und PayPal. Für 6- und 12-Monats-Laufzeiten zusätzlich Überweisung auf Anfrage.'],
      },
      {
        q: 'Gibt es eine kostenlose Testphase?',
        a: ['Ja. Der freie Zugang zeigt dir das Prinzip mit reduzierter Planungstiefe. Die volle 10-Jahres-Projektion und alle Pro-Funktionen sind in den bezahlten Laufzeiten enthalten.'],
      },
      {
        q: 'Brauche ich für jeden meiner Interessenten ein eigenes Abo?',
        a: [
          'Nein. Ein Abo ist auf dich als Sponsor lizenziert. Du nutzt es für beliebig viele Gespräche mit beliebig vielen Interessenten — auf deinen Geräten oder per geteiltem URL-Link.',
          'Wenn dein Interessent das Tool selbst nutzen möchte (nachdem er Sponsor geworden ist), schließt er ein eigenes Abo ab.',
        ],
      },
      {
        q: 'Was passiert mit meinen Szenarien, wenn ich kündige?',
        a: ['Free speichert keine eigenen Szenarien. In Pro kannst du deine aktuelle Planung weiter nutzen; bei Kündigung schaltet die App nach Ablauf des Zugangs wieder in den freien Umfang.'],
      },
    ],
  },

  finalCta: {
    headlineHtml: 'Eine Entscheidung. <em>Ein Werkzeug.</em>',
    sub: 'Frei testen oder direkt im Gespräch nutzen — beides startet mit einem Klick.',
    ctaLabel: 'Simulator starten',
  },
} satisfies PricingPage;
---
<BrandLayout
  brand={brand}
  title={pricing.seo.title}
  description={pricing.seo.description}
  paddle
>
  <Header brand={brand} active="pricing" />
  <PricingPageDefault brand={brand} pricing={pricing} source="brands/eqology/pages/pricing.astro" />
  <Footer brand={brand} />
</BrandLayout>
