---
import type { Brand } from '@shared/content-schemas/config';
import B2BHeaderBanner from '@shared/components/checkout/B2BHeaderBanner.astro';

type PlanKey = 'monthly' | 'halfyear' | 'yearly';

interface Props {
  brand: Brand;
  tierName: string;
  plan: PlanKey;
  priceId: string;
  source?: string;
}
const { brand, tierName, plan, priceId, source } = Astro.props;

// Server-side Initial-Render. Die echten Werte kommen aus der serverseitig
// erstellten Paddle-Transaktion (Step 2). Bis dahin zeigen wir die DE-
// Default-Werte. Siehe Hinweis "preview-hint" unter den Totals.
const planPricing: Record<PlanKey, { netPeriod: number; periodLabel: string; periodMonths: number }> = {
  monthly:  { netPeriod: 14.95,  periodLabel: 'Monat',     periodMonths: 1  },
  halfyear: { netPeriod: 82.23,  periodLabel: 'Halbjahr',  periodMonths: 6  },
  yearly:   { netPeriod: 149.50, periodLabel: 'Jahr',      periodMonths: 12 },
};
const VAT_RATE = 0.19;
const net = planPricing[plan].netPeriod;
const vat = net * VAT_RATE;
const gross = net + vat;
const periodLabel  = planPricing[plan].periodLabel;
const periodMonths = planPricing[plan].periodMonths;

const renewalDate = new Date();
renewalDate.setMonth(renewalDate.getMonth() + periodMonths);
const renewalLabel = renewalDate.toLocaleDateString('de-DE', {
  day: '2-digit', month: '2-digit', year: 'numeric',
});

function eur(value: number): string {
  return value.toFixed(2).replace('.', ',') + ' EUR';
}

const consentVersion = '2026-06-01';
const b2bConfirmationVersion = 'b2b-v2026-06-02';
const displayedHintsHash     = 'hints-v2026-06-02';

const envApiBase = import.meta.env.PUBLIC_API_BASE_URL;
const apiBaseUrl = (typeof envApiBase === 'string' && envApiBase.trim() !== '')
  ? envApiBase
  : (brand.apiBaseUrl ?? '');
---

<B2BHeaderBanner siteName={brand.siteName} />

<section
  class="checkout"
  data-section="Pro Checkout"
  data-component-file="shared/components/sections/CheckoutPage.astro"
  data-source={source}
  data-api-base={apiBaseUrl}
  data-brand-id={brand.id}
  data-app-url={brand.appUrl}
  data-paddle-token={brand.paddle.clientToken}
  data-paddle-env={brand.paddle.env}
  data-price-id={priceId}
  data-plan={plan}
  data-net-period={net.toFixed(2)}
  data-vat-rate={VAT_RATE.toString()}
  data-consent-version={consentVersion}
  data-b2b-confirmation-version={b2bConfirmationVersion}
  data-displayed-hints-hash={displayedHintsHash}
>
  <div class="shell">

    <!-- ============== LEFT: Bestelluebersicht ============== -->
    <aside class="summary" id="summary">

      <div class="lock-hint">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
        <span>Daten gesperrt. Änderungen über <strong>"Daten ändern"</strong> rechts.</span>
      </div>

      <div class="sum-h">Bestellübersicht</div>

      <!-- Rabattcode (einziger Input in der linken Spalte) -->
      <div class="inline-field" id="discountField">
        <div class="inline-field-header">
          <span class="inline-field-label">
            Rabattcode <span class="optional">optional</span>
          </span>
          <span class="status-pill" id="discountPill">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="3">
              <polyline points="20 6 9 17 4 12" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Code gespeichert
          </span>
        </div>
        <div class="inline-field-row">
          <input
            type="text" id="discountInput"
            placeholder="z.B. DAO20"
            autocomplete="off" spellcheck="false" maxlength="40"
          />
          <button class="inline-field-btn" id="discountApplyBtn">Anwenden</button>
        </div>
        <p class="inline-field-hint">
          Hast du einen Sponsor- oder Aktionscode? Wird bei "Weiter zur Zahlung" gegen Paddle validiert.
        </p>
        <p class="inline-field-feedback" id="discountFeedback"></p>
      </div>

      <!-- Hero-Preis -->
      <div class="price-hero">
        <div class="amount-row">
          <span class="amount-main" id="heroAmount">{eur(net)}</span>
          <span class="amount-tax-label" id="heroTaxLabel">zzgl. USt.</span>
        </div>
        <div class="recurring">dann <span id="periodRecurring">{eur(net)}</span> netto pro {periodLabel}</div>
        <div class="gross-hint" id="grossHint">{eur(gross)} brutto inkl. 19% USt. (DE)</div>
      </div>

      <!-- Produkt-Karte -->
      <div class="product">
        <div class="product-icon">
          <img
            src="/lifeflow_product_icon.png"
            alt={`${brand.siteName} Pro`} width="44" height="44"
          />
        </div>
        <div class="product-info">
          <div class="product-name">{brand.siteName} Pro</div>
          <div class="product-plan">{tierName} · automatische Verlängerung</div>
          <div class="product-qty">Menge: 1</div>
        </div>
      </div>

      <!-- Rechnungs-Zeilen -->
      <div class="lines">
        <div class="line">
          <span class="label">Zwischensumme (netto)</span>
          <span class="value" id="lineNet">{eur(net)}</span>
        </div>
        <div class="line discount-line" id="lineDiscount" style="display:none">
          <span class="label">Rabatt <span id="lineDiscountLabel"></span></span>
          <span class="value" id="lineDiscountValue">-0,00 EUR</span>
        </div>
        <div class="line tax-line" id="lineTax">
          <span class="label">
            USt. <span class="label-soft" id="lineTaxRate">(19%)</span>
          </span>
          <span class="value" id="lineTaxValue">{eur(vat)}</span>
        </div>
      </div>

      <div class="divider"></div>

      <div class="totals">
        <div class="total">
          <span>Heute fällig</span>
          <span class="value" id="totalToday">{eur(gross)}</span>
        </div>
        <div class="future">
          <span>Fällig am {renewalLabel}</span>
          <span id="totalFuture">{eur(gross)}</span>
        </div>
      </div>

      <p class="preview-hint" id="previewHint">
        Vorläufige Berechnung. Endgültige Steuer richtet sich nach Land + USt-IdNr (Paddle).
      </p>

      <div class="trust">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2">
          <path d="M12 2l8 4v6c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6z"/>
        </svg>
        Zahlung &amp; Rechnung über Paddle als Merchant of Record
      </div>
    </aside>

    <!-- ============== RIGHT: Wizard ============== -->
    <div class="right">

      <!-- ===== STEP 1: Rechnungsdaten ===== -->
      <section class="step-panel" id="step1">
        <h1 class="panel-h">Bezahlung abschließen</h1>

        <div class="stepper">
          <div class="step-dot active" id="dot1"><span>1</span></div>
          <div class="step-line" id="stepLine"></div>
          <div class="step-dot" id="dot2"><span>2</span></div>
        </div>
        <div class="step-labels">
          <span class="step-label active" id="label1">Rechnungsdaten</span>
          <span class="step-label" id="label2">Zahlung</span>
        </div>

        <div class="intent-banner" id="intentBanner" role="alert" aria-live="polite">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="9"/><path d="M12 8v4M12 16h.01" stroke-linecap="round"/>
          </svg>
          <span id="intentBannerText"></span>
        </div>

        <p class="panel-sub">
          Gib deine vollständigen Rechnungsdaten ein. Diese erscheinen auf
          deiner Paddle-Rechnung.
        </p>

        <div class="invoice-block">
          <div class="invoice-block-h">Rechnungsempfänger</div>

          <div class="field-block">
            <label for="checkoutEmail">E-Mail-Adresse <span class="req">*</span></label>
            <input id="checkoutEmail" type="email" autocomplete="email"
                   inputmode="email" spellcheck="false" required
                   placeholder="name@beispiel.de" />
            <p class="field-hint" id="emailHint">Für Rechnung, Zugang und Login.</p>
          </div>

          <div class="field-block">
            <label for="checkoutCompany">Firma / Name <span class="req">*</span></label>
            <input id="checkoutCompany" type="text" autocomplete="organization"
                   maxlength="200" required
                   placeholder="z.B. Max Mustermann Vertrieb" />
            <p class="field-hint">Erscheint so auf der Rechnung. Einzelunternehmer: Vor- und Nachname.</p>
          </div>

          <div class="field-block">
            <label for="checkoutStreet">Straße und Hausnummer <span class="req">*</span></label>
            <input id="checkoutStreet" type="text" autocomplete="street-address"
                   maxlength="100" required
                   placeholder="z.B. Musterstraße 12" />
          </div>

          <div class="field-row">
            <div class="field-block">
              <label for="checkoutZip">PLZ <span class="req">*</span></label>
              <input id="checkoutZip" type="text" autocomplete="postal-code"
                     maxlength="10" required placeholder="12345" />
            </div>
            <div class="field-block">
              <label for="checkoutCity">Ort <span class="req">*</span></label>
              <input id="checkoutCity" type="text" autocomplete="address-level2"
                     maxlength="100" required placeholder="Musterstadt" />
            </div>
          </div>

          <div class="field-block">
            <label for="checkoutCountry">Land <span class="req">*</span></label>
            <select id="checkoutCountry" required>
              <optgroup label="DACH">
                <option value="DE" selected>Deutschland</option>
                <option value="AT">Österreich</option>
                <option value="CH">Schweiz</option>
              </optgroup>
              <optgroup label="EU (weitere)">
                <option value="BE">Belgien</option>
                <option value="BG">Bulgarien</option>
                <option value="CY">Zypern</option>
                <option value="CZ">Tschechien</option>
                <option value="DK">Dänemark</option>
                <option value="EE">Estland</option>
                <option value="ES">Spanien</option>
                <option value="FI">Finnland</option>
                <option value="FR">Frankreich</option>
                <option value="GR">Griechenland</option>
                <option value="HR">Kroatien</option>
                <option value="HU">Ungarn</option>
                <option value="IE">Irland</option>
                <option value="IT">Italien</option>
                <option value="LT">Litauen</option>
                <option value="LU">Luxemburg</option>
                <option value="LV">Lettland</option>
                <option value="MT">Malta</option>
                <option value="NL">Niederlande</option>
                <option value="PL">Polen</option>
                <option value="PT">Portugal</option>
                <option value="RO">Rumänien</option>
                <option value="SE">Schweden</option>
                <option value="SI">Slowenien</option>
                <option value="SK">Slowakei</option>
              </optgroup>
            </select>
          </div>

          <div class="field-block vat-field" style="margin-bottom: 0;">
            <label for="checkoutVat">USt-IdNr. <span class="optional">optional</span></label>
            <input id="checkoutVat" type="text" autocomplete="off"
                   spellcheck="false" maxlength="20"
                   placeholder="z.B. AT123456789" />
            <p class="field-hint">
              Bei EU-USt-IdNr außerhalb DE entfällt die deutsche USt (Reverse-Charge).
              Paddle prüft via VIES.
            </p>
            <p class="vat-field-feedback" id="vatFeedback"></p>
          </div>
        </div>

        <div class="sec-label">Zustimmungen</div>
        <div class="checks">
          <label class="check" id="wrap-agb">
            <input type="checkbox" id="chk-agb">
            <span class="cbox">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none"
                   stroke="#fff" stroke-width="3.5"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span class="label">
              Ich akzeptiere die <a href="/agb.html" target="_blank">AGB</a><span class="req">*</span>
            </span>
          </label>

          <label class="check" id="wrap-dse">
            <input type="checkbox" id="chk-dse">
            <span class="cbox">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none"
                   stroke="#fff" stroke-width="3.5"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span class="label">
              Ich habe die <a href="/datenschutz.html" target="_blank">Datenschutzerklärung</a> gelesen<span class="req">*</span>
            </span>
          </label>

          <label class="check check--b2b" id="wrap-b2b">
            <input type="checkbox" id="chk-b2b">
            <span class="cbox">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none"
                   stroke="#fff" stroke-width="3.5"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span class="label">
              Ich bestätige, dass ich diesen Vertrag in Ausübung meiner gewerblichen
              oder selbständigen beruflichen Tätigkeit (§14 BGB) abschließe und
              nicht als Verbraucher. Mir ist bewusst, dass hierdurch
              <strong>kein Widerrufsrecht</strong> nach §312g BGB besteht.<span class="req">*</span>
              <span class="hint">{brand.siteName} ist ein Angebot ausschließlich für gewerbliche und selbständige Nutzer.</span>
            </span>
          </label>

          <label class="check" id="wrap-newsletter">
            <input type="checkbox" id="chk-newsletter">
            <span class="cbox">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none"
                   stroke="#fff" stroke-width="3.5"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span class="label">
              Newsletter mit Produkt-Updates erhalten<span class="opt">(optional)</span>
            </span>
          </label>
        </div>
        <p class="check-footnote"><span class="req">*</span> Pflichtfeld</p>

        <button class="cta" id="nextBtn" disabled>
          <span class="cta-label">Weiter zur Zahlung</span>
          <svg class="cta-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2.5">
            <path d="M5 12h14M13 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span class="spinner"></span>
        </button>
        <p class="cta-missing-hint" id="missingHint"></p>
      </section>

      <!-- ===== STEP 2: Zahlung ===== -->
      <section class="step-panel" id="step2" hidden>
        <h1 class="panel-h">Bezahlung abschließen</h1>

        <div class="stepper">
          <div class="step-dot done"><span>&check;</span></div>
          <div class="step-line done"></div>
          <div class="step-dot active"><span>2</span></div>
        </div>
        <div class="step-labels">
          <span class="step-label">Rechnungsdaten</span>
          <span class="step-label active">Zahlung</span>
        </div>

        <p class="panel-sub">Schließe die Zahlung im sicheren Paddle-Feld ab.</p>

        <div class="konto-readonly">
          <div class="konto-label">
            <span>Rechnungsempfänger</span>
            <button type="button" class="link-btn" id="backBtn">&larr; Daten ändern</button>
          </div>
          <div class="konto-data">
            <div class="konto-row">
              <span class="konto-row-label">E-Mail</span>
              <span class="konto-row-value" id="kontoEmail">—</span>
            </div>
            <div class="konto-row">
              <span class="konto-row-label">Firma</span>
              <span class="konto-row-value" id="kontoCompany">—</span>
            </div>
            <div class="konto-row">
              <span class="konto-row-label">Anschrift</span>
              <span class="konto-row-value multiline" id="kontoAddress">—</span>
            </div>
            <div class="konto-row" id="kontoVatRow" style="display:none">
              <span class="konto-row-label">USt-IdNr.</span>
              <span class="konto-row-value" id="kontoVat">—</span>
            </div>
          </div>
        </div>

        <div class="sync-banner" id="syncBanner">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2.4">
            <path d="M21 12a9 9 0 1 1-3.5-7.1" stroke-linecap="round"/>
            <polyline points="21 4 21 10 15 10" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <div>
            <strong id="syncBannerTitle">Paddle-Transaktion erstellt</strong>
            <div class="sync-sub" id="syncBannerSub">
              Rechnungsdaten und ggf. Rabatt + USt-IdNr wurden serverseitig an Paddle übermittelt.
            </div>
          </div>
        </div>

        <p class="err-msg" id="errMsg">Bitte später erneut versuchen.</p>

        <div class="sec-label">Zahlungsfeld</div>
        <div class="paddle-wrap" id="paddleWrap">
          <div class="paddle-placeholder">Paddle-Zahlungsfeld wird geladen ...</div>
        </div>

        <p class="legal">
          Abwicklung &amp; Rechnungsstellung durch <a href="https://paddle.com" target="_blank">Paddle.com</a>.
          Automatische Verlängerung um die gewählte Laufzeit zum jeweils gültigen Rabattpreis dieses Tarifs; Preisanpassungen werden rechtzeitig mitgeteilt, im Fall einer Erhöhung mit Sonderkündigungsrecht. Ab der ersten Verlängerung monatlich zum Monatsende kündbar; nicht genutzte volle Restmonate erstatten wir anteilig zurück.
        </p>
      </section>
    </div>

    <!-- Success-View nach checkout.completed -->
    <section class="step-panel success-view" id="successView" hidden>
      <div class="success-icon">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2.5">
          <polyline points="20 6 9 17 4 12" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <h2>Vielen Dank für deinen Kauf</h2>
      <p>Wir haben die Zahlungsbestätigung von Paddle erhalten und verarbeiten deinen Zugang.</p>
      <p>
        Konto-E-Mail: <strong id="successEmail"></strong><br/>
        <span id="successMail" class="success-mail-status"></span>
      </p>
      <a href={brand.appUrl} class="success-app-link">Jetzt App öffnen</a>
      <p class="success-hint">Du kannst diese Seite geöffnet lassen oder später in die App wechseln.</p>
    </section>
  </div>
</section>

<script>
  import { setupCheckoutInline } from '@shared/scripts/checkoutInline';
  setupCheckoutInline();
</script>

<style>
  .checkout {
    background:
      radial-gradient(900px 420px at 100% 0%, color-mix(in srgb, var(--brand) 18%, white), transparent 60%),
      radial-gradient(720px 360px at 0% 100%, color-mix(in srgb, var(--brand) 12%, white), transparent 60%),
      #FAFBF9;
    min-height: 100vh;
    padding: 0 20px 48px;
    display: flex; align-items: flex-start; justify-content: center;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    color: #0F1B17;
    line-height: 1.55;
  }

  .shell {
    width: 100%; max-width: 1000px;
    display: grid;
    grid-template-columns: 0.95fr 1.1fr;
    background: #fff;
    border: 1px solid #E1E5E2;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 30px 80px -40px rgba(15,27,23,0.30);
  }
  @media (max-width: 860px) { .shell { grid-template-columns: 1fr; } }

  /* LEFT */
  .summary {
    background: linear-gradient(180deg, #fff 0%, var(--brand-surface) 100%);
    border-right: 1px solid #E1E5E2;
    padding: 28px 26px;
    display: flex; flex-direction: column;
    position: relative;
  }
  @media (max-width: 860px) {
    .summary { border-right: none; border-bottom: 1px solid #E1E5E2; }
  }

  .sum-h {
    font-size: 22px; font-weight: 600;
    letter-spacing: -0.3px;
    margin-bottom: 14px;
  }

  .lock-hint {
    display: none;
    margin: 0 0 12px;
    padding: 9px 12px;
    background: #fff;
    border: 1px solid #E1E5E2;
    border-left: 3px solid var(--brand);
    border-radius: 7px;
    font-size: 11.5px; color: #4A5C53;
    line-height: 1.45;
    align-items: center; gap: 8px;
  }
  .summary.locked .lock-hint { display: flex; }
  .lock-hint svg { flex-shrink: 0; color: var(--brand); }

  .inline-field {
    margin: 4px 0 14px;
    padding: 12px 14px;
    background: #fff;
    border: 1px solid #E1E5E2;
    border-radius: 10px;
    transition: border-color .15s, background .15s, opacity .15s;
  }
  .inline-field.applied { border-color: #B6DCC1; background: #ECF6EF; }
  .inline-field.invalid { border-color: #C2364B; background: #FDF3F4; }
  .summary.locked .inline-field { opacity: 0.7; pointer-events: none; }
  .summary.locked .inline-field input { background: transparent; }
  .summary.locked .inline-field-btn { display: none; }

  .inline-field-header {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 7px; min-height: 18px;
  }
  .inline-field-label {
    font-family: 'JetBrains Mono', 'SF Mono', Menlo, monospace;
    font-size: 10.5px; color: #4A5C53;
    letter-spacing: 0.08em; text-transform: uppercase;
    font-weight: 500;
  }
  .inline-field-label .optional {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 11px; color: #7A8983;
    text-transform: none; letter-spacing: 0;
    font-style: italic; font-weight: 400;
    margin-left: 6px;
  }
  .status-pill {
    display: none; align-items: center; gap: 5px;
    padding: 2px 8px; border-radius: 999px;
    font-size: 10.5px; font-weight: 600;
    background: #2C7A4D; color: #fff;
  }
  .inline-field.applied .status-pill { display: inline-flex; }

  .inline-field-row { display: flex; gap: 8px; }
  .inline-field input {
    flex: 1; padding: 9px 11px;
    font-family: inherit; font-size: 13.5px;
    background: #fff; border: 1px solid #E1E5E2;
    border-radius: 8px; color: #0F1B17;
  }
  .inline-field input:focus {
    outline: none; border-color: var(--brand);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--brand) 14%, transparent);
  }
  .inline-field.applied input { border-color: #B6DCC1; }
  .inline-field-btn {
    padding: 9px 14px;
    background: var(--brand); color: #fff;
    border: none; border-radius: 8px;
    font-family: inherit; font-size: 13px; font-weight: 600;
    cursor: pointer; white-space: nowrap;
    transition: background .12s, opacity .12s;
  }
  .inline-field-btn:hover:not(:disabled) { background: var(--brand-dark); }
  .inline-field-btn:disabled { opacity: 0.5; cursor: not-allowed; }
  .inline-field-btn.remove {
    background: transparent; color: #4A5C53;
    border: 1px solid #E1E5E2;
