---
import type { Brand, PricingPage } from '@shared/content-schemas/config';

type Tier = PricingPage['tiers'][number];
type PlanKey = 'monthly' | 'halfyear' | 'yearly';

interface Props {
  brand: Brand;
  tier: Tier;
  plan: PlanKey;
  priceId: string;
  source?: string;
}
const { brand, tier, plan, priceId, source } = Astro.props;

// Pricing-Logik server-side. netPeriod ist der Netto-Betrag der gesamten
// Abrechnungsperiode (nicht /Monat) — aus pricing.yaml billed-Text destilliert.
// vatRate ist Default 19% (DE) — Paddle berechnet im Checkout den
// kundenstandort-spezifischen Satz; unsere Sidebar zeigt nur die DE-Annahme.
const planPricing: Record<PlanKey, { netPeriod: number; periodLabel: string; periodMonths: number }> = {
  monthly:  { netPeriod: 14.95,  periodLabel: 'Monat',     periodMonths: 1  },
  halfyear: { netPeriod: 82.23,  periodLabel: 'Halbjahr',  periodMonths: 6  },
  yearly:   { netPeriod: 149.50, periodLabel: 'Jahr',      periodMonths: 12 },
};
const VAT_RATE = 0.19;

const net = planPricing[plan].netPeriod;
const vat = net * VAT_RATE;
const gross = net + vat;
const periodLabel  = planPricing[plan].periodLabel;
const periodMonths = planPricing[plan].periodMonths;

const renewalDate = new Date();
renewalDate.setMonth(renewalDate.getMonth() + periodMonths);
const renewalLabel = renewalDate.toLocaleDateString('de-DE', {
  day: '2-digit', month: '2-digit', year: 'numeric',
});

function eur(value: number): string {
  return value.toFixed(2).replace('.', ',') + ' EUR';
}

const consentVersion = '2026-06-01';

// Lokale Dev-Overrides via .env.local (PUBLIC_API_BASE_URL). In Production
// ist die Var nicht gesetzt → fallback auf brand.yaml.
// WICHTIG: leeren String explizit als "nicht gesetzt" behandeln. Sonst wuerde
// `PUBLIC_API_BASE_URL=` (leer fuer Vite-Proxy-Dev) den brand.yaml-Wert
// auch im Production-Build ueberschreiben → relative URLs → 404 auf IONOS.
const envApiBase = import.meta.env.PUBLIC_API_BASE_URL;
const apiBaseUrl = (typeof envApiBase === 'string' && envApiBase.trim() !== '')
  ? envApiBase
  : (brand.apiBaseUrl ?? '');
---

<section
  class="checkout"
  data-section="Pro Checkout"
  data-component-file="shared/components/sections/CheckoutPage.astro"
  data-source={source}
  data-api-base={apiBaseUrl}
  data-brand-id={brand.id}
  data-app-url={brand.appUrl}
  data-paddle-token={brand.paddle.clientToken}
  data-paddle-env={brand.paddle.env}
  data-price-id={priceId}
  data-plan={plan}
  data-net-period={net.toFixed(2)}
  data-vat-rate={VAT_RATE.toString()}
  data-consent-version={consentVersion}
>
  <div class="shell">

    <!-- ============== LEFT: Bestelluebersicht ============== -->
    <aside class="summary">
      <div class="sum-h">Bestelluebersicht</div>

      <div class="price-hero">
        <span class="amount">{eur(gross)}</span>
        <span class="tax">inkl. MwSt.</span>
      </div>
      <div class="price-sub">
        dann {eur(gross)} pro {periodLabel}
        <span class="info-icon" title="Automatische Verlaengerung — jederzeit kuendbar">i</span>
      </div>

      <div class="product">
        <div class="product-icon">
          <img
            src="/lifeflow_product_icon.png"
            alt={`${brand.siteName} Pro`} width="44" height="44"
          />
        </div>
        <div class="product-info">
          <div class="product-name">{brand.siteName} Pro</div>
          <div class="product-plan">{tier.name} · automatische Verlaengerung</div>
          <div class="product-qty">Menge: 1</div>
        </div>
      </div>

      <div class="lines">
        <div class="line">
          <span class="label">Zwischensumme (netto)</span>
          <span class="value">{eur(net)}</span>
        </div>
        <div class="line discount-hint">
          <span class="label">Rabattcode</span>
          <span class="value-soft">im Zahlungsfeld einloesen</span>
        </div>
        <div class="line">
          <span class="label">MwSt. (19%)</span>
          <span class="value">{eur(vat)}</span>
        </div>
      </div>

      <div class="divider"></div>

      <div class="totals">
        <div class="total">
          <span>Heute faellig</span>
          <span class="value">{eur(gross)}</span>
        </div>
        <div class="future">
          <span>Faellig am {renewalLabel}</span>
          <span>{eur(gross)}</span>
        </div>
      </div>

      <div class="trust">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2">
          <path d="M12 2l8 4v6c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6z"/>
        </svg>
        Zahlung &amp; Rechnung ueber Paddle als Merchant of Record
      </div>
    </aside>

    <!-- ============== RIGHT: Form (Wizard 2 Steps) ============== -->
    <section class="form form-active">
      <h1>Bezahlung abschliessen</h1>

      <!-- Stepper-Indicator -->
      <div class="stepper" role="progressbar" aria-valuemin="1" aria-valuemax="2">
        <div class="step-dot step-dot--active" id="dot1"><span>1</span></div>
        <div class="step-line"><div class="step-line-fill" id="stepLineFill"></div></div>
        <div class="step-dot" id="dot2"><span>2</span></div>
      </div>
      <div class="step-labels">
        <span class="step-label step-label--active" id="label1">Daten</span>
        <span class="step-label" id="label2">Zahlung</span>
      </div>

      <!-- Banner fuer Server-Intent-Hinweise (Email-Mismatch, login_required etc.) -->
      <div class="intent-banner" id="intentBanner" role="alert" aria-live="polite">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="9"/><path d="M12 8v4M12 16h.01" stroke-linecap="round"/>
        </svg>
        <span id="intentBannerText"></span>
      </div>

      <!-- ===== STEP 1: Daten + Pflicht-Consents ===== -->
      <div class="step" id="step1">
        <p class="lead">
          Pruefe deine E-Mail-Adresse und bestaetige die Pflicht-Zustimmungen.
        </p>

        <div class="email-block">
          <label for="checkoutEmail">E-Mail-Adresse</label>
          <input
            id="checkoutEmail"
            type="email"
            autocomplete="email"
            inputmode="email"
            spellcheck="false"
            required
            placeholder="name@beispiel.de"
          />
          <p class="email-hint" id="emailHint">
            Wird fuer Rechnung, Zugang und Login verwendet.
          </p>
        </div>

        <div class="sec-label">Zustimmungen</div>
        <div class="checks">
          <label class="check" id="wrap-agb">
            <input type="checkbox" id="chk-agb">
            <span class="cbox">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none"
                   stroke="#fff" stroke-width="3.5"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span class="label">
              Ich akzeptiere die <a href="agb.html" target="_blank">AGB</a><span class="req">*</span>
            </span>
          </label>

          <label class="check" id="wrap-dse">
            <input type="checkbox" id="chk-dse">
            <span class="cbox">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none"
                   stroke="#fff" stroke-width="3.5"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span class="label">
              Ich habe die <a href="datenschutz.html" target="_blank">Datenschutzerklaerung</a> gelesen<span class="req">*</span>
            </span>
          </label>

          <label class="check" id="wrap-newsletter">
            <input type="checkbox" id="chk-newsletter">
            <span class="cbox">
              <svg width="11" height="11" viewBox="0 0 24 24" fill="none"
                   stroke="#fff" stroke-width="3.5"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span class="label">
              Newsletter mit Produkt-Updates erhalten<span class="opt">(optional)</span>
            </span>
          </label>
        </div>
        <p class="check-footnote"><span class="req">*</span> Pflichtfeld</p>

        <button class="cta" id="nextBtn" disabled>
          <span class="cta-label">Weiter zur Zahlung</span>
          <svg class="cta-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2.5">
            <path d="M5 12h14M13 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span class="spinner"></span>
        </button>
        <p class="err-msg" id="errMsgStep1">Bitte E-Mail, AGB und Datenschutz bestaetigen.</p>
      </div>

      <!-- ===== STEP 2: Zahlung + Widerruf + Submit ===== -->
      <div class="step" id="step2" hidden>
        <p class="lead">
          Gib deine Zahlungsdaten ein und schliesse den Kauf ab.
        </p>

        <div class="konto-readonly">
          <div class="konto-label">Konto</div>
          <div class="konto-row">
            <span class="konto-email" id="kontoEmail">name@beispiel.de</span>
            <button type="button" class="link-btn" id="backBtn">&larr; Daten aendern</button>
          </div>
        </div>

        <div class="sec-label">Sofortstart</div>
        <label class="check check--withdrawal" id="wrap-widerruf">
          <input type="checkbox" id="chk-widerruf">
          <span class="cbox">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none"
                 stroke="#fff" stroke-width="3.5"><path d="M20 6L9 17l-5-5"/></svg>
          </span>
          <span class="label">
            Ich stimme ausdruecklich zu, dass LifeFlow360 Pro sofort startet, und bestaetige, dass ich dadurch mein Widerrufsrecht fuer den bereits gestarteten digitalen Dienst verliere.
            <span class="opt">(optional)</span>
          </span>
        </label>

        <p class="legal checkout-prep">
          Ohne diese Zustimmung bleibt dein 14-taegiges Widerrufsrecht bestehen.
          Der finale Zahlungsklick erfolgt im Paddle-Zahlungsfeld.
        </p>

        <button class="cta" id="payBtn" disabled>
          <span class="cta-label" id="payBtnLabel">Kauf abschliessen</span>
          <span class="spinner"></span>
        </button>
        <p class="err-msg" id="errMsg">Bitte lade zuerst das Zahlungsfeld.</p>

        <div class="sec-label">Zahlungsfeld</div>
        <div class="paddle-wrap" id="paddleWrap">
          <div class="paddle-placeholder">Waehle zuerst, ob du sofort starten moechtest. Danach laden wir das sichere Paddle-Zahlungsfeld.</div>
        </div>

        <p class="legal">
          Abwicklung &amp; Rechnungsstellung durch <a href="https://paddle.com" target="_blank">Paddle.com</a>.
          Automatische Verlaengerung, jederzeit im Customer-Portal kuendbar.
          <span class="opt-hint" id="optHint">Du behaeltst dein 14-taegiges Widerrufsrecht.</span>
        </p>
      </div>
    </section>

    <!-- Success-View nach checkout.completed (initial hidden) -->
    <section class="form success-view" id="successView" hidden>
      <div class="success-icon">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2.5">
          <polyline points="20 6 9 17 4 12" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <h2>Vielen Dank fuer deinen Kauf</h2>
      <p>
        Wir haben die Zahlungsbestaetigung von Paddle erhalten und verarbeiten deinen Zugang.
      </p>
      <p>
        Konto-E-Mail: <strong id="successEmail"></strong><br/>
        <span id="successMail" class="success-mail-status"></span>
      </p>
      <p class="success-hint">Du kannst diese Seite geoeffnet lassen oder spaeter in die App wechseln.</p>
    </section>
  </div>
</section>

<script>
  import { setupCheckoutInline } from '@shared/scripts/checkoutInline';
  setupCheckoutInline();
</script>

<style>
  .checkout {
    background:
      radial-gradient(900px 420px at 100% 0%, color-mix(in srgb, var(--brand) 18%, white), transparent 60%),
      radial-gradient(720px 360px at 0% 100%, color-mix(in srgb, var(--brand) 12%, white), transparent 60%),
      #FAFBF9;
    min-height: 100vh;
    padding: 48px 20px;
    display: flex; align-items: flex-start; justify-content: center;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    color: #0F1B17;
    line-height: 1.55;
  }

  .shell {
    width: 100%; max-width: 980px;
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    background: #fff;
    border: 1px solid #E1E5E2;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 30px 80px -40px rgba(15,27,23,0.30);
  }
  @media (max-width: 820px) { .shell { grid-template-columns: 1fr; } }

  /* ============== LEFT: Bestelluebersicht ============== */
  .summary {
    background: linear-gradient(180deg, #fff 0%, var(--brand-surface) 100%);
    border-right: 1px solid #E1E5E2;
    padding: 32px 30px;
    display: flex; flex-direction: column;
  }
  @media (max-width: 820px) {
    .summary { border-right: none; border-bottom: 1px solid #E1E5E2; }
  }

  .sum-h {
    font-size: 22px; font-weight: 600;
    letter-spacing: -0.3px;
    color: #0F1B17;
    margin-bottom: 12px;
  }

  .price-hero {
    display: flex; align-items: baseline; gap: 8px;
    margin-bottom: 4px;
  }
  .price-hero .amount {
    font-size: 36px; font-weight: 700;
    color: var(--brand);
    letter-spacing: -0.5px;
  }
  .price-hero .tax {
    font-size: 13px; color: #4A5C53; font-weight: 500;
  }
  .price-sub {
    font-size: 13px; color: #4A5C53;
    margin-bottom: 22px;
  }
  .price-sub .info-icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 14px; height: 14px; margin-left: 2px;
    border-radius: 50%; background: #E1E5E2;
    color: #7A8983; font-size: 9px; font-weight: 700;
    vertical-align: middle; cursor: help;
  }

  .product {
    display: flex; gap: 12px; align-items: flex-start;
    padding: 14px;
    background: #fff;
    border: 1px solid #E1E5E2;
    border-radius: 12px;
    margin-bottom: 18px;
  }
  .product-icon {
    width: 44px; height: 44px; flex-shrink: 0;
    border-radius: 9px;
    overflow: hidden;
    background: var(--brand-surface);
  }
  .product-icon img {
    width: 100%; height: 100%; display: block;
    object-fit: cover;
  }
  .product-info { flex: 1; min-width: 0; }
  .product-name {
    font-weight: 600; font-size: 14px;
    color: #0F1B17; margin-bottom: 2px;
  }
  .product-plan {
    font-size: 12px; color: #4A5C53;
    margin-bottom: 4px;
  }
  .product-qty {
    font-family: 'JetBrains Mono', 'SF Mono', Menlo, monospace;
    font-size: 10.5px; color: #7A8983;
    text-transform: uppercase; letter-spacing: 0.06em;
  }

  .lines { margin-bottom: 4px; }
  .line {
    display: flex; justify-content: space-between; align-items: baseline;
    padding: 8px 0;
    font-size: 13.5px;
  }
  .line .label { color: #4A5C53; }
  .line .value { color: #0F1B17; font-weight: 500; }
  .line .value-soft { color: var(--brand); font-weight: 500; font-size: 12.5px; }
  .line.discount-hint { padding: 6px 0; }

  .divider {
    height: 1px; background: #E1E5E2;
    margin: 6px 0;
  }

  .totals { margin-top: 8px; }
  .total {
    display: flex; justify-content: space-between; align-items: baseline;
    padding: 10px 0;
    font-size: 14px; font-weight: 700;
    color: #0F1B17;
  }
  .total .value {
    font-size: 18px; font-weight: 700;
    color: var(--brand);
  }
  .future {
    display: flex; justify-content: space-between; align-items: baseline;
    padding: 6px 0 2px;
    font-size: 12px; color: #7A8983;
  }

  .trust {
    margin-top: auto; padding-top: 22px;
    display: flex; align-items: center; gap: 7px;
    font-size: 11.5px; color: #7A8983;
  }
  .trust svg { color: var(--brand); flex-shrink: 0; }

  /* ============== RIGHT: Form ============== */
  .form {
    padding: 32px 30px;
    display: flex; flex-direction: column;
  }
  .form h1 {
    font-size: 22px; font-weight: 600;
    letter-spacing: -0.3px;
    color: #0F1B17; margin-bottom: 4px;
  }
  .form .lead {
    font-size: 13.5px; color: #4A5C53;
    margin-bottom: 20px;
  }

  .email-block { margin-bottom: 18px; }
  .email-block label {
    display: block;
    font-family: 'JetBrains Mono', 'SF Mono', Menlo, monospace;
    font-size: 10.5px; color: #4A5C53;
    letter-spacing: 0.08em; text-transform: uppercase;
    font-weight: 500;
    margin-bottom: 6px;
  }
  .email-block input {
    width: 100%;
    padding: 11px 13px;
    font-family: inherit;
    font-size: 14px;
    color: #0F1B17;
    background: #fff;
    border: 1px solid #E1E5E2;
    border-radius: 10px;
    transition: border-color .15s, box-shadow .15s, background .15s;
  }
  .email-block input::placeholder { color: #A8B2AD; }
  .email-block input:focus {
    outline: none;
    border-color: var(--brand);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--brand) 14%, transparent);
  }
  .email-block input.invalid {
    border-color: #C2364B;
    background: #FDF3F4;
  }
  .email-hint {
    margin: 6px 0 0;
    font-size: 11.5px; color: #7A8983;
    line-height: 1.5;
  }
  .email-hint.error { color: #C2364B; }

  .sec-label {
    font-family: 'JetBrains Mono', 'SF Mono', Menlo, monospace;
    font-size: 10.5px; color: #4A5C53;
    letter-spacing: 0.08em; text-transform: uppercase;
    font-weight: 500;
    margin-bottom: 8px;
  }

  .paddle-wrap {
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid #E1E5E2;
    background: #FAFBF9;
    margin-bottom: 18px;
    /* Kompakte Mindesthoehe fuer Placeholder; Paddle setzt das Iframe spaeter
       per frameStyle: min-height:420px;. */
    min-height: 64px;
  }
  /* Hat das Iframe Hoehe, wird die paddle-wrap automatisch hoeher. Sobald
     Paddle gemountet ist, fuehlt sich die Box trotzdem nicht "kollabierend"
     an dank Iframe-Innenhoehe. */
  .paddle-wrap:has(iframe) { min-height: 420px; }
  .paddle-wrap iframe { border: none !important; display: block; }
  .paddle-placeholder {
    padding: 18px 20px;
    text-align: center;
    color: #7A8983;
    font-family: 'JetBrains Mono', 'SF Mono', Menlo, monospace;
    font-size: 11.5px; line-height: 1.55;
  }

  /* Compact checkboxes — "*" Pflicht-Pattern */
  .checks { margin-bottom: 8px; }
  .check {
    display: flex; align-items: flex-start; gap: 10px;
    padding: 9px 0;
    cursor: pointer;
    border-bottom: 1px solid #EEF1EF;
  }
  .check:last-child { border-bottom: none; }
  .check input {
    position: absolute; opacity: 0; width: 0; height: 0;
  }
  .check .cbox {
    flex-shrink: 0; width: 18px; height: 18px; margin-top: 1px;
    border: 1.5px solid #B4CDB9; border-radius: 5px; background: #fff;
    display: flex; align-items: center; justify-content: center;
    transition: background .12s, border-color .12s;
  }
  .check.checked .cbox {
    background: var(--brand); border-color: var(--brand);
  }
  .check.error .cbox { border-color: #C2364B; background: #FDF3F4; }
  .cbox svg { opacity: 0; transition: opacity .1s; }
  .check.checked .cbox svg { opacity: 1; }
  .check .label {
    font-size: 13px; line-height: 1.45; color: #2C4138;
  }
  .check .label .req {
    color: #C2364B; font-weight: 700; margin-left: 1px;
  }
  .check .label .opt {
    color: #7A8983; font-size: 12px; margin-left: 4px; font-style: italic;
  }
  .check .label a {
    color: var(--brand); text-decoration: underline; text-underline-offset: 2px;
  }

  .check-footnote {
    font-size: 11px; color: #7A8983;
    margin: 6px 0 16px 28px;
  }
  .check-footnote .req {
    color: #C2364B; font-weight: 700;
  }

  .cta {
    width: 100%; padding: 14px;
    font-family: inherit; font-size: 15px; font-weight: 700;
    color: #fff; background: var(--cta);
    border: none; border-radius: 10px; cursor: pointer;
    display: flex; align-items: center; justify-content: center; gap: 9px;
    box-shadow: 0 4px 16px -4px color-mix(in srgb, var(--cta) 40%, transparent);
    transition: background .12s, transform .08s, opacity .12s;
    letter-spacing: 0.01em;
  }
  .cta:hover:not(:disabled) { background: var(--cta-dark); }
  .cta:active:not(:disabled) { transform: translateY(1px); }
  .cta:disabled {
    opacity: 0.4; cursor: not-allowed;
    background: var(--cta); box-shadow: none;
  }
  .cta .spinner {
    display: none;
    width: 15px; height: 15px;
    border: 2px solid rgba(255,255,255,0.4);
    border-top-color: #fff; border-radius: 50%;
    animation: cta-spin .7s linear infinite;
  }
  .cta.loading .spinner { display: block; }
  .cta.loading .cta-label { opacity: 0.5; }
  @keyframes cta-spin { to { transform: rotate(360deg); } }

  .err-msg {
    display: none;
    color: #C2364B; font-size: 12px;
    margin-top: 8px;
  }
  .err-msg.show { display: block; }

  .cta-arrow {
    margin-left: 4px;
    transition: transform .15s;
  }
  .cta:not(:disabled):hover .cta-arrow { transform: translateX(3px); }

  /* hidden-Attribut greift sonst nicht auf .form, weil .form display:flex hat */
  .form[hidden], section[hidden], div[hidden] { display: none !important; }

  /* ============== STEPPER ============== */
  .stepper {
    display: flex; align-items: center; gap: 0;
    margin: 4px 0 6px;
  }
  .step-dot {
    flex-shrink: 0;
    width: 28px; height: 28px;
    border-radius: 50%;
    background: #fff;
    border: 1.5px solid #D5D8D6;
    display: flex; align-items: center; justify-content: center;
