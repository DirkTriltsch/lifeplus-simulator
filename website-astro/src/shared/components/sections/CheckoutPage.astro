---
// Checkout-Seite (Schritt 1 Rechnungsdaten, Schritt 2 Paddle-Zahlung).
// Aus TraderScope uebernommen (checkout/[plan].astro + billing/*), angepasst
// auf LifeFlow360: Marken-Tokens, Katalog aus shared/lib/plans.ts, Texte aus
// shared/content/billingTexts.ts, Verbraucher/Unternehmer-Umschalter.
// Die Logik steckt in shared/scripts/checkoutPage.ts.
import type { Brand } from '@shared/content-schemas/config';
import { billingTexts } from '@shared/content/billingTexts';
import { amountsFor, formatEur, PLAN_CATALOG, type PlanId } from '@shared/lib/plans';
import BillingSummaryCard from '@shared/components/billing/BillingSummaryCard.astro';
import ConsentChecks from '@shared/components/billing/ConsentChecks.astro';

interface Props {
  brand: Brand;
  plan: PlanId;
  priceId: string;
  source?: string;
}
const { brand, plan, priceId, source } = Astro.props;

const texts = billingTexts(brand);
const entry = PLAN_CATALOG[plan];
const amounts = amountsFor(plan);
const submitLabel = texts.checkout.submitLabel(entry.checkoutLabel, formatEur(amounts.grossCents));

// Versionsstrings fuer das Consent-Audit (consent_log / checkout_intents).
// Bei inhaltlicher Aenderung der Zustimmungstexte hochzaehlen.
const consentVersion = '2026-10-31';
const b2bConfirmationVersion = 'b2b-v2026-06-02';
const displayedHintsHash = 'hints-v2026-06-02';

const envApiBase = import.meta.env.PUBLIC_API_BASE_URL;
const apiBaseUrl = typeof envApiBase === 'string' && envApiBase.trim() !== '' ? envApiBase : (brand.apiBaseUrl ?? '');

const COUNTRIES_DACH: Array<[string, string]> = [['DE', 'Deutschland'], ['AT', 'Österreich'], ['CH', 'Schweiz']];
const COUNTRIES_EU: Array<[string, string]> = [
  ['BE', 'Belgien'], ['BG', 'Bulgarien'], ['HR', 'Kroatien'], ['CY', 'Zypern'], ['CZ', 'Tschechien'],
  ['DK', 'Dänemark'], ['EE', 'Estland'], ['ES', 'Spanien'], ['FI', 'Finnland'], ['FR', 'Frankreich'],
  ['GR', 'Griechenland'], ['HU', 'Ungarn'], ['IE', 'Irland'], ['IT', 'Italien'], ['LV', 'Lettland'],
  ['LT', 'Litauen'], ['LU', 'Luxemburg'], ['MT', 'Malta'], ['NL', 'Niederlande'], ['PL', 'Polen'],
  ['PT', 'Portugal'], ['RO', 'Rumänien'], ['SE', 'Schweden'], ['SK', 'Slowakei'], ['SI', 'Slowenien'],
];
---
<section class="ck-hero">
  <div class="ck-breadcrumb">
    <a href="/index.html">Start</a><span class="sep">/</span>
    <a href="/pricing.html">Preise</a><span class="sep">/</span>
    Bezahlung
  </div>
  <h1 set:html={texts.checkout.heroTitleHtml} />
  <p class="ck-lead">{texts.checkout.heroLead}</p>
</section>

<div
  class="ck-shell"
  data-checkout-page
  data-section="Pro Checkout"
  data-component-file="shared/components/sections/CheckoutPage.astro"
  data-source={source}
  data-api-base={apiBaseUrl}
  data-brand-id={brand.id}
  data-app-url={brand.appUrl}
  data-paddle-token={brand.paddle.clientToken}
  data-paddle-env={brand.paddle.env}
  data-price-id={priceId}
  data-plan={plan}
  data-plan-name={entry.checkoutLabel}
  data-period-months={entry.months}
  data-net-cents={amounts.netCents}
  data-vat-cents={amounts.vatCents}
  data-gross-cents={amounts.grossCents}
  data-consent-version={consentVersion}
  data-b2b-confirmation-version={b2bConfirmationVersion}
  data-displayed-hints-hash={displayedHintsHash}
  data-success-url="/checkout/success.html"
  data-consumer-name-label={texts.checkout.consumerNameLabel}
  data-consumer-name-hint={texts.checkout.consumerNameHint}
  data-business-name-label={texts.checkout.businessNameLabel}
  data-business-name-hint={texts.checkout.businessNameHint}
  data-email-hint={texts.checkout.emailHint}
>
  <BillingSummaryCard brand={brand} plan={plan} />

  <div class="ck-form-col">
    <div class="ck-card">
      <div class="ck-steps" data-step-indicator data-current-step="1">
        <div class="ck-step" data-step="1"><span class="ck-step-dot">1</span><span>{texts.checkout.stepLabels[0]}</span></div>
        <div class="ck-step-bar"></div>
        <div class="ck-step" data-step="2"><span class="ck-step-dot">2</span><span>{texts.checkout.stepLabels[1]}</span></div>
      </div>

      <h2 class="ck-form-h2">{texts.checkout.formTitle}</h2>

      <div class="ck-banner ck-banner--warn" data-checkout-banner role="alert" hidden></div>

      <section data-step-pane="1">
        <p class="ck-form-intro">{texts.checkout.step1Intro}</p>

        <form data-checkout-form novalidate>
          <fieldset class="ck-buyer">
            <legend>{texts.checkout.buyerTypeLegend}</legend>
            <div class="ck-seg">
              <label><input type="radio" name="buyerType" value="consumer" checked /><span>{texts.checkout.consumerLabel}</span></label>
              <label><input type="radio" name="buyerType" value="business" /><span>{texts.checkout.businessLabel}</span></label>
            </div>
          </fieldset>

          <div class="ck-section-h">Rechnungsempfänger</div>

          <div class="ck-field">
            <label for="checkoutEmail">E-Mail-Adresse <span class="ck-req">*</span></label>
            <input id="checkoutEmail" name="checkoutEmail" type="email" placeholder="name@beispiel.de" autocomplete="email" inputmode="email" required />
            <p class="ck-hint" data-email-hint>{texts.checkout.emailHint}</p>
          </div>

          <div class="ck-field">
            <label for="legalName"><span data-name-label>{texts.checkout.consumerNameLabel}</span> <span class="ck-req">*</span></label>
            <input id="legalName" name="legalName" type="text" autocomplete="name" required minlength="2" maxlength="200" />
            <p class="ck-hint" data-name-hint>{texts.checkout.consumerNameHint}</p>
          </div>

          <div class="ck-field">
            <label for="street">Straße und Hausnummer <span class="ck-req">*</span></label>
            <input id="street" name="street" type="text" placeholder="Musterstraße 1" autocomplete="billing address-line1" required minlength="3" maxlength="200" />
          </div>

          <div class="ck-row">
            <div class="ck-field">
              <label for="postalCode">PLZ <span class="ck-req">*</span></label>
              <input id="postalCode" name="postalCode" type="text" placeholder="80331" autocomplete="billing postal-code" required minlength="3" maxlength="32" />
            </div>
            <div class="ck-field">
              <label for="city">Ort <span class="ck-req">*</span></label>
              <input id="city" name="city" type="text" placeholder="München" autocomplete="billing address-level2" required minlength="2" maxlength="120" />
            </div>
          </div>

          <div class="ck-field">
            <label for="countryCode">Land <span class="ck-req">*</span></label>
            <select id="countryCode" name="countryCode" autocomplete="billing country" required>
              <optgroup label="DACH">
                {COUNTRIES_DACH.map(([code, label]) => <option value={code} selected={code === 'DE'}>{label}</option>)}
              </optgroup>
              <optgroup label="EU (weitere)">
                {COUNTRIES_EU.map(([code, label]) => <option value={code}>{label}</option>)}
              </optgroup>
            </select>
            <p class="ck-hint">Paddle nutzt die Anschrift für Steuerberechnung und Rechnung.</p>
          </div>

          <div class="ck-field" data-buyer-only="business" hidden>
            <label for="vatId">USt-IdNr. <span class="ck-opt">optional</span></label>
            <input id="vatId" name="vatId" type="text" placeholder="z. B. ATU12345678" autocomplete="off" spellcheck="false" maxlength="20" />
            <p class="ck-hint">{texts.checkout.vatHint}</p>
            <p class="ck-feedback" data-vat-feedback hidden></p>
          </div>

          <ConsentChecks texts={texts.checkout} />

          <button class="ck-btn" type="submit" data-checkout-submit data-plan-name={entry.checkoutLabel} data-label-template={texts.checkout.submitLabel(entry.checkoutLabel, '{amount}')} disabled>{submitLabel}</button>
          <p class="ck-submit-hint" data-submit-hint>Bitte alle Pflichtfelder ausfüllen.</p>
        </form>
      </section>

      <section data-step-pane="2" hidden>
        <p class="ck-form-intro">{texts.checkout.step2Intro}</p>

        <div class="ck-ro-header">
          <span class="ck-section-h">Rechnungsempfänger</span>
          <button type="button" class="ck-back" data-step-back>← Daten ändern</button>
        </div>
        <dl class="ck-readonly" data-readonly>
          <div><dt>E-Mail</dt><dd data-ro="email"></dd></div>
          <div><dt data-ro-name-label>Name</dt><dd data-ro="name"></dd></div>
          <div><dt>Anschrift</dt><dd data-ro="address"></dd></div>
          <div data-ro-vat-row hidden><dt>USt-IdNr.</dt><dd data-ro="vatId"></dd></div>
        </dl>

        <div class="ck-section-h">Zahlungsfeld</div>
        <div class="ck-paddle" id="paddle-wrap" data-paddle-wrap>
          <div class="ck-paddle-placeholder">Paddle-Zahlungsfeld wird geladen …</div>
        </div>
      </section>

      <p class="ck-foot" set:html={texts.checkout.paddleFooterHtml} />
    </div>
  </div>
</div>

<script>
  import { setupCheckoutPage } from '@shared/scripts/checkoutPage';
  setupCheckoutPage();
</script>
