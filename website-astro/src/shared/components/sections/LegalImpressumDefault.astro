---
import type { Brand } from '@shared/content-schemas/config';
import type { Contact } from '@shared/lib/contact';

interface Props { brand: Brand; contact: Contact; source?: string; }
const { brand, contact, source } = Astro.props;
---
<div
  data-section="LegalImpressumDefault.astro"
  data-component-file="shared/components/sections/LegalImpressumDefault.astro"
  data-source={source}
>
  <p class="legal-meta-top">Rechtliche Informationen</p>
  <h1>Impressum</h1>

  <h2>Anbieter</h2>
  <address>
    {contact.name}<br />
    betreibt {brand.siteName} unter {brand.siteDomain}<br />
    {contact.addressLine1}<br />
    {contact.addressLine2}<br />
    {contact.addressLine3}
  </address>

  <h2>Kontakt</h2>
  <p>
    Telefon: {contact.phone}<br />
    E-Mail: <a href={`mailto:${contact.email}`}>{contact.email}</a>
  </p>

  {(contact.registerCourt || contact.registerNumber) && (
    <Fragment>
      <h2>Registereintrag</h2>
      <p>
        {contact.registerCourt && <>Registergericht: {contact.registerCourt}<br /></>}
        {contact.registerNumber && <>Registernummer: {contact.registerNumber}</>}
      </p>
    </Fragment>
  )}

  {contact.vatId && (
    <Fragment>
      <h2>Umsatzsteuer-Identifikationsnummer</h2>
      <p>
        USt-IdNr. nach §27a Umsatzsteuergesetz: {contact.vatId}
      </p>
    </Fragment>
  )}

  {contact.smallBusinessNote && (
    <Fragment>
      <h2>Hinweis zur Umsatzsteuer</h2>
      <p>{contact.smallBusinessNote}</p>
    </Fragment>
  )}

  {contact.responsibleForContent && (
    <Fragment>
      <h2>Inhaltlich verantwortlich</h2>
      <p>
        Verantwortlich für den Inhalt nach §18 Abs. 2 MStV:<br />
        {contact.responsibleForContent}<br />
        {contact.addressLine1}<br />
        {contact.addressLine2}<br />
        {contact.addressLine3}
      </p>
    </Fragment>
  )}

  <h2>Online-Streitbeilegung</h2>
  <p>
    Die EU-Kommission stellt eine Plattform zur Online-Streitbeilegung bereit:
    <a href="https://ec.europa.eu/consumers/odr" target="_blank" rel="noopener">ec.europa.eu/consumers/odr</a>.
    Wir sind nicht bereit oder verpflichtet, an Streitbeilegungsverfahren
    vor einer Verbraucherschlichtungsstelle teilzunehmen.
  </p>

  <p class="legal-meta">Grundlage: angepasst aus dem bestehenden eRecht24-Text.</p>
</div>
